<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>
<body>
    <h1>EJS Practice</h1>
    <h2>Hello, <%= person.name %></h2>
    <h3>Occupation: <%= person.occupation %></h3>
    <p>FavoriteColor: <%= person.favoriteColor %></p>

    <!-- Part III: Occupation decision -->
    <% if (person.favoriteColor.toLowerCase() === 'blue') { %>
        <p>Blue is a cool color!</p>
    <% } else if (person.favoriteColor.toLowerCase() === 'red') { %>
        <p>Red is a mean color!</p>
    <% } else { %>
        <p>That's a nice color!</p>
    <% } %>
</body>
</html>