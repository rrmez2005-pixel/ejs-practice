<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Favorite Movies</title>
</head>
<body>
  <%- include('partials/header') %>
  <main>
    <h1>Favorite Movies:</h1>
    <ul>
      <% movies.forEach(movie => { %>
        <li><%= movie %></li>
      <% }); %>
    </ul>
  </main>
  <%- include('partials/footer') %>
</body>
</html>